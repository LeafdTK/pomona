{
  "manifest_version": 3,
  "name": "Pomona",
  "version": "0.2.0",
  "description": "A morning brief, written from your own Slack, GitHub and calendar by your own Claude. Ready before you open the browser.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:7777/*",
    "http://localhost:7777/*",
    "https://pomona.leafd.dev/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pomona",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
